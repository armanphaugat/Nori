# ─── Database (Supabase / Postgres) ───────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:6543/postgres

# ─── Redis (use service name "redis" inside Docker Compose) ───────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
BOT_SHARED_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=rt
ENV=production

# ─── URLs (production — nori.dev) ─────────────────────────────────────────
FRONTEND_URL=https://nori.dev
DISCORD_REDIRECT_URI=https://nori.dev/api/auth/discord/callback

# ─── Discord OAuth (dashboard login) ────────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_API=https://discord.com/api/v10
DISCORD_OAUTH_URL=https://discord.com/oauth2/authorize
DISCORD_TOKEN_URL=https://discord.com/api/oauth2/token

# ─── Discord bot (set BOTH to the same bot token) ─────────────────────────────
DISCORD_BOT_KEY=
DISCORD_BOT_TOKEN=

# ─── LLM / search (comma-separated for key rotation) ──────────────────────────
GROQ_API_KEY=key1,key2
TAVILY_API_KEY=
EXA_API_KEY=

# ─── Graphlit RAG ─────────────────────────────────────────────────────────────
GRAPHLIT_ENVIRONMENT_ID=
GRAPHLIT_ORGANIZATION_ID=
GRAPHLIT_ORGANIZATION_KEY=
GRAPHLIT_JWT_SECRET=
