# ─── Stage 1: Python dependency builder ───────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


# ─── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libsm6 libxext6 libxrender1 \
    curl \
    ffmpeg \
    tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

ENV UVICORN_WORKERS=1

COPY --from=builder /install /usr/local

COPY backend/   ./backend/
COPY bot/       ./bot/
COPY python/    ./python/
COPY dbhelper/  ./dbhelper/
COPY utils/     ./utils/
COPY prompt.txt ./prompt.txt
COPY scripts/start-app.sh ./scripts/start-app.sh

RUN sed -i 's/\r//' ./scripts/start-app.sh && chmod +x ./scripts/start-app.sh

EXPOSE 12000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:12000/ || exit 1

CMD ["./scripts/start-app.sh"]